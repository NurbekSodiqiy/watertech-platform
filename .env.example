NEXT_PUBLIC_SUPABASE_URL= # Supabase project URL (public, safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY= # Supabase anon/publishable key (public, RLS-scoped)
# Supabase service-role secret (server-only, bypasses RLS — never expose). Prefer the new `sb_secret_...`
# format (Supabase dashboard -> Settings -> API -> API keys -> "Create new secret key"); the legacy
# JWT-shaped service_role key is still accepted but is being phased out — see "Secret rotation runbook" in
# README.md.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SENTRY_DSN= # Sentry DSN (public); Sentry.init is skipped entirely when empty
SENTRY_AUTH_TOKEN= # Sentry auth token (server-only); set only in CI/deploy to enable source map upload
SUPABASE_PROJECT_ID= # Supabase project ref — used only by `npm run gen:types` (Supabase CLI), never read by the app
GEMINI_API_KEY= # Google Gemini API key (server-only, from https://aistudio.google.com/apikey); unset = Copilot disabled (503)
COPILOT_MODEL= # Gemini model for Copilot; defaults to gemini-2.5-flash when empty
# Bearer secret (server-only, at least 32 characters) for GET /api/cron/content-scan; Vercel Cron sends it
# automatically. Generate one with: openssl rand -base64 48
CRON_SECRET=
# Seed guard (supabase/seed/guard.ts) — read only by `npm run seed:content`, never by the app.
# The seed refuses to run unless SEED_TARGET=staging and the project ref parsed from
# NEXT_PUBLIC_SUPABASE_URL is absent from PROD_PROJECT_REFS. Set these in the shell for a seed run
# rather than here, so a stray .env.local never pre-authorises a write. See docs/TESTING.md.
SEED_TARGET= # "staging" — anything else (or unset) refuses
PROD_PROJECT_REFS= # comma-separated production project refs that must never be seeded
# Build-time escape hatch for lib/content/safe.ts: "allow-empty" lets `next build` prerender empty pages
# when Supabase is unreachable. CI sets it because it builds against a placeholder project. LEAVE EMPTY
# here and in production — unset is what makes a broken deploy fail loudly. See docs/TESTING.md.
CONTENT_BUILD_MODE=
